# ── Firebase web config ──────────────────────────────────────────────
# Copy this file to ".env" and fill in the values from your Firebase project:
# Firebase Console → Project settings → General → "Your apps" → Web app → SDK config.
# These values are NOT secret — they ship to the browser. Access is controlled
# by the email allow-list below and by your Firestore security rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Access control ───────────────────────────────────────────────────
# Comma-separated list of Google account emails allowed to sign in.
# Anyone signing in with an email NOT on this list is rejected automatically.
# Leave empty to allow any signed-in Google user (not recommended).
VITE_ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
